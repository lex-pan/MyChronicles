{
    "name": "MyChronicles Extension",
    "version": "1.0",
    "description": "keep track of what you read or watch online, all without lifting a finger",
    "author": "Lex Pan",
    "manifest_version": 3,
    "icons": {
        "128": "extension.png"
    },
    "permissions": [
        "tabs",
        "storage"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "browser_specific_settings": {
        "gecko": {
          "id": "mychronicles@lexsprojects.ca" 
        }
    },
    "action": {
        "default_popup": "index.html"
    },
    "content_scripts":[
        {
            "matches": [
                "http://example.com/",
                "https://*.lightnovelcave.com/novel/*/chapter-*",
                "https://chapmanganato.to/*/*",
                "https://asuracomic.net/*/",
                "https://asianc.sh/*episode*",
                "https://wuxiaworld.site/novel/*/chapter*",
                "*://mangadex.org/*"
            ],
            "js": ["contentScript.js"]
        }
    ]
}